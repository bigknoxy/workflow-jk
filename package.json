{
  "name": "workflow-jk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:eslint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:contract": "turbo run test:contract",
    "test:workflow": "turbo run test:workflow",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "seed": "tsx packages/testing/src/seed.ts",
    "db:migrate": "tsx packages/adapters/src/db/migrate.ts",
    "eval": "bun run --cwd packages/evaluation src/run-eval.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0",
    "@types/node": "^26.5.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "shell-quote": ">=1.8.3",
    "vitest": ">=2.1.10",
    "sharp": ">=0.35.0",
    "protobufjs": ">=7.6.1",
    "@grpc/grpc-js": ">=1.13.0"
  }
}
