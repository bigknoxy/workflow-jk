{
  "name": "workflow-jk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:eslint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:contract": "turbo run test:contract",
    "test:workflow": "turbo run test:workflow",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "seed": "tsx packages/testing/src/seed.ts",
    "db:migrate": "tsx packages/adapters/src/db/migrate.ts",
    "eval": "bun run --cwd packages/evaluation src/run-eval.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "7.2.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "shell-quote": ">=1.8.4",
    "vitest": ">=3.2.6",
    "sharp": ">=0.35.0",
    "protobufjs": ">=7.6.1",
    "@grpc/grpc-js": ">=1.14.4",
    "brace-expansion": ">=5.0.9",
    "js-yaml": ">=4.3.2",
    "find-my-way": ">=9.9.0",
    "postcss": ">=8.5.28",
    "nanoid": ">=3.3.18",
    "browserslist": ">=4.28.9",
    "fast-uri": ">=3.1.6",
    "vite": ">=7.2.6",
    "prom-client": ">=0.217.0",
    "@opentelemetry/sdk-node": ">=0.217.0",
    "@opentelemetry/propagator-jaeger": ">=2.9.0"
  }
}